{
  "lexicon": 1,
  "id": "com.jscarrott.hyperlocal.permissions",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "Hyperlocal",
      "detail": "Read and write place notes in a Hyperlocal space",
      "permissions": [
        {
          "type": "permission",
          "resource": "space",
          "spaceType": "com.jscarrott.hyperlocal.space",
          "authority": "*",
          "skey": "self",
          "collection": ["com.jscarrott.hyperlocal.note"],
          "action": ["read", "create", "update", "delete"],
          "manage": ["create", "update", "delete"]
        }
      ]
    }
  }
}
